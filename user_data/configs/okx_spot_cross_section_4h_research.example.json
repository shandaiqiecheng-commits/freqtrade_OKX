      "DOT/USDT",
      "LTC/USDT",
      "BCH/USDT",
      "TRX/USDT",
      "SUI/USDT",
      "APT/USDT",
      "NEAR/USDT",
      "FIL/USDT",
      "ATOM/USDT",
      "ETC/USDT",
